# worktree-deck configuration. Copy to `worktree-deck.conf` at your repo root,
# or to ~/.config/worktree-deck/config for a global default.
#
# This file is sourced as shell, so you can set variables AND override any wtd_*
# hook function. Every value is optional; omit the [stack] bits entirely for
# pure worktree management with no Docker.

# --- Layout (auto-derived from git when omitted) ---------------------------
# WTD_MAIN_REPO="$HOME/code/myapp"
# WTD_WORKTREES_DIR="$HOME/code/myapp-worktrees"

# --- Dev stack (OPTIONAL) --------------------------------------------------
# Container-name templates; {suffix} becomes the per-worktree suffix.
# WTD_SERVICE_TEMPLATES=("myapp-backend{suffix}" "myapp-frontend{suffix}")
#
# Commands to bring a worktree's stack up / down. {path} = worktree path
# (omit {path} and the command runs with the worktree as cwd).
# WTD_STACK_START="make start-worktree"
# WTD_STACK_STOP="make stop-worktree"
# WTD_E2E_CMD="make e2e-test"
#
# Serialize stack-start host-globally (only one worktree's start runs at a time).
# Off by default; enable when your start command touches host-global resources
# (a shared file-sync session, a shared image builder, shared background sweeps)
# that two concurrent starts would trample. Diagnose/repair the lock with
# `worktree-deck lock-health [--repair]`. Tunables: WTD_STACK_START_LOCK (path),
# WTD_STACK_START_LOCK_TIMEOUT (default 1800s), WTD_STACK_START_LOCK_LONG_HELD.
# WTD_SERIALIZE_STACK_START=1
#
# Refuse to start a worktree's stack when this many stacks are already running
# (0/unset = unlimited). Counts running containers derived from the first
# WTD_SERVICE_TEMPLATES entry, so it caps concurrent stacks to protect host RAM.
# WTD_BACKEND_CAP=7
#
# Command run (worktree as cwd) to regenerate a worktree's env after
# `worktree-deck continue` switches its branch. Empty => skip (re-run start).
# WTD_ENV_REGEN_CMD="bash scripts/worktree-env.sh"

# --- .env keys the console reads for display -------------------------------
# WTD_BACKEND_PORT_KEY="BACKEND_PORT"
# WTD_FRONTEND_PORT_KEY="FRONTEND_PORT"
# WTD_SLOT_ENV_KEY="WTD_SLOT"

# Optional: .env keys recording each worktree's ACTUAL container names. Matched
# in addition to the branch-derived names, so renamed-branch / custom-named
# containers still match their worktree instead of looking orphaned.
# WTD_ENV_CONTAINER_KEYS="BACKEND_CONTAINER_NAME FRONTEND_CONTAINER_NAME"

# --- Agents the console can launch in a worktree (first = default) ----------
WTD_AGENT_LAUNCHERS=(claude codex)

# --- Optional remote Docker daemon -----------------------------------------
# WTD_REMOTE_DOCKER_HOST="ssh://user@build-host"

# --- Optional: bridge session events to another tool -----------------------
# WTD_EVENT_SINK="agentic-pr-dash record"

# --- Optional: background daemons the console can toggle --------------------
# WTD_DAEMONS=(agentic-pr-dash)
